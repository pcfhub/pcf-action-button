<data name="ActionButton_Name" xml:space="preserve">
    <value>Botón de acción</value>
  </data>
  <data name="ActionButton_Desc" xml:space="preserve">
    <value>Un botón para aplicaciones de lienzo que genera OnSelect, con confirmación opcional en dos pasos.</value>
  </data>

  <data name="label_Name" xml:space="preserve">
