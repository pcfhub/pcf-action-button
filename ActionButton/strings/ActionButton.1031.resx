<data name="ActionButton_Name" xml:space="preserve">
    <value>Aktionsschaltfläche</value>
  </data>
  <data name="ActionButton_Desc" xml:space="preserve">
    <value>Eine Schaltfläche für Canvas-Apps, die OnSelect auslöst – mit optionaler zweistufiger Bestätigung.</value>
  </data>

  <data name="label_Name" xml:space="preserve">
    <value>Beschriftung</value>
  </data>
  <data name="label_Desc" xml:space="preserve">
    <value>Der Text auf der Schaltfläche. Er ist zugleich ihr zugänglicher Name.</value>
  </data>
  <data name="confirmRequired_Name" xml:space="preserve">
    <value>Bestätigung verlangen</value>
  </data>
  <data name="confirmRequired_Desc" xml:space="preserve">
    <value>Vor dem Handeln nachfragen: der erste Druck scharft die Schaltfläche, der zweite löst OnSelect aus.</value>
  </data>
  <data name="confirmLabel_Name" xml:space="preserve">
    <value>Bestätigungstext</value>
  </data>
  <data name="confirmLabel_Desc" xml:space="preserve">
