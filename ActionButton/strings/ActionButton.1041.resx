<data name="ActionButton_Name" xml:space="preserve">
    <value>アクションボタン</value>
  </data>
  <data name="ActionButton_Desc" xml:space="preserve">
    <value>OnSelect を発生させるキャンバスアプリ向けのボタン。任意で 2 段階の確認を使えます。</value>
  </data>

  <data name="label_Name" xml:space="preserve">
    <value>ラベル</value>
  </data>
  <data name="label_Desc" xml:space="preserve">
    <value>ボタンのテキスト。アクセシビリティ名も兼ねます。</value>
  </data>
  <data name="confirmRequired_Name" xml:space="preserve">
    <value>確認を必須にする</value>
  </data>
  <data name="confirmRequired_Desc" xml:space="preserve">
    <value>実行前に確認します。1 回目の押下で待機状態になり、2 回目で OnSelect を発生させます。</value>
  </data>
  <data name="confirmLabel_Name" xml:space="preserve">
    <value>確認ラベル</value>
  </data>
  <data name="confirmLabel_Desc" xml:space="preserve">
    <value>待機状態でのボタンの表示。空の場合は既定値を使います。</value>
  </data>

  <data name="icon_Name" xml:space="preserve">
    <value>アイコン</value>
  </data>
  <data name="icon_Desc" xml:space="preserve">
